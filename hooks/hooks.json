{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start\"",
            "async": false,
            "timeout": 30000,
            "platforms": ["linux", "macos"]
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${env:CLAUDE_PLUGIN_ROOT}/hooks/session-start.ps1\"",
            "async": false,
            "timeout": 30000,
            "platforms": ["windows"]
          }
        ]
      }
    ]
  }
}
